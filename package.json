{
    "name": "pure-effect",
    "version": "0.17.0",
    "description": "Records what your business logic did in production and replays it anywhere: time-travel debugging for JavaScript and TypeScript, with zero dependencies. Business logic is plain data you can test without mocks.",
    "keywords": [
        "effect",
        "effect-system",
        "functional-core",
        "imperative-shell",
        "time-travel",
        "replay",
        "tracing",
        "testing",
        "zero-dependencies",
        "typescript"
    ],
    "type": "module",
    "exports": "./index.js",
    "types": "./index.d.ts",
    "files": [
        "index.js",
        "index.d.ts",
        "CHANGELOG.md",
        "examples"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "test": "mocha && tsd && tsc -p jsconfig.json",
        "test:ts-minimum": "npx --yes -p typescript@5.1 tsc -p test/tsconfig.minimum.json",
        "generate": "node scripts/effect-pipe-overloads.js",
        "format": "prettier --write index.js index.d.ts examples/*.js scripts/*.js test/all.js test/types.test-d.ts README.md CLAUDE.md DESIGN.md CHANGELOG.md CONTRIBUTING.md"
    },
    "tsd": {
        "directory": "test",
        "compilerOptions": {
            "exactOptionalPropertyTypes": true
        }
    },
    "author": "Aycan Gulez",
    "homepage": "https://pure-effect.org",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aycangulez/pure-effect.git"
    },
    "bugs": {
        "url": "https://github.com/aycangulez/pure-effect/issues"
    },
    "license": "MIT",
    "devDependencies": {
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
        "@opentelemetry/sdk-node": "^0.221.0",
        "@opentelemetry/sdk-trace-base": "^2.10.0",
        "@stryker-mutator/core": "^10.0.0",
        "@stryker-mutator/mocha-runner": "^10.0.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.10.1",
        "mocha": "^11.3.0",
        "prettier": "^3.9.6",
        "tsd": "^0.33.0",
        "typescript": "^5.9.3"
    }
}
